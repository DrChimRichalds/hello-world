   "source": [
    "def factorial(num):\n",
    "    global saved_sum \n",
    "    saved_sum = 1\n",
    "    for number in range(num,0,-1): \n",
    "        sum = number * (number - 1)\n",
    "        saved_sum = saved_sum * number\n",
    "    return saved_sum\n",
    "        \n",
    "\n",
    "\n",
    "\n",
    "factorial(12)\n",
    "\n",
    "#print(([1,2,3,4,5,6]))"
   ]
